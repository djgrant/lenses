{
  "name": "@notation/hmrc/vat-payment-history",
  "url": "https://www.tax.service.gov.uk/vat-through-software/payment-history",
  "params": {
    "limit": {
      "type": "integer",
      "default": 10
    }
  },
  "returns": {
    "type": "array",
    "items": {
      "date": "string",
      "description": "string",
      "period": {
        "type": "string",
        "nullable": true
      },
      "paidToHmrc": {
        "type": "number",
        "nullable": true
      },
      "paidByHmrc": {
        "type": "number",
        "nullable": true
      }
    }
  },
  "outcomes": {
    "needs_auth": {
      "hint": "HMRC session expired or not signed in. Open https://www.tax.service.gov.uk/business-account in the browser, sign in, then retry."
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "item": "#content .govuk-tabs__panel table.govuk-table tbody tr",
      "fields": {
        "date": {
          "selector": "td:nth-child(1)"
        },
        "description": {
          "selector": "td:nth-child(2) span"
        },
        "period": {
          "selector": "td:nth-child(2) p"
        },
        "paidToHmrc": {
          "selector": "td:nth-child(3)"
        },
        "paidByHmrc": {
          "selector": "td:nth-child(4)"
        }
      },
      "post": "([$.{ 'date': $text(date), 'description': $text(description), 'period': $text(period), 'paidToHmrc': $money(paidToHmrc), 'paidByHmrc': $money(paidByHmrc) }][[0..$limit - 1]])",
      "detect": {
        "needs_auth": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
      }
    }
  ]
}
