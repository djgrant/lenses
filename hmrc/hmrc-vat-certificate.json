{
  "name": "@djgrant/hmrc/vat-certificate",
  "url": "https://www.tax.service.gov.uk/vat-through-software/vat-certificate",
  "returns": {
    "type": "object",
    "fields": {
      "vrn": "string",
      "registrationDate": "string",
      "certificateDate": "string",
      "businessName": "string",
      "tradingName": "string",
      "businessType": "string",
      "sicCode": "string",
      "principalPlaceOfBusiness": "string",
      "returnDates": "string"
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "fields": {
        "vrn": {
          "selector": "dd.vrn"
        },
        "registrationDate": {
          "selector": "dd.registration-date"
        },
        "certificateDate": {
          "selector": "dd.certificate-date"
        },
        "businessName": {
          "selector": "dd.business-name"
        },
        "tradingName": {
          "selector": "dd.trading-name"
        },
        "businessType": {
          "selector": "dd.business-type"
        },
        "sicCode": {
          "selector": "dd.trade-classification"
        },
        "principalPlaceOfBusiness": {
          "selector": "dd.ppob"
        },
        "returnDates": {
          "selector": "dd.stp"
        }
      },
      "post": "({ 'vrn': $text(vrn), 'registrationDate': $text(registrationDate), 'certificateDate': $text(certificateDate), 'businessName': $text(businessName), 'tradingName': $text(tradingName), 'businessType': $text(businessType), 'sicCode': $text(sicCode), 'principalPlaceOfBusiness': $text(principalPlaceOfBusiness), 'returnDates': $text(returnDates) })",
      "exceptions": {
        "needs_auth": {
          "matches": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
        }
      }
    }
  ]
}
