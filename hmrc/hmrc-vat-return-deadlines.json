{
  "name": "@djgrant/hmrc/vat-return-deadlines",
  "url": "https://www.tax.service.gov.uk/vat-through-software/vat-returns/return-deadlines",
  "returns": {
    "type": "array",
    "items": {
      "dueDate": "string",
      "period": "string",
      "periodStart": "string",
      "periodEnd": "string"
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "item": "#content .govuk-form-group ul.govuk-list > li",
      "fields": {
        "dueDate": {
          "selector": "p.govuk-body-l"
        },
        "period": {
          "selector": "p.vatvc-grey-paragraph-text"
        }
      },
      "post": "([$.( $p := $strip(period, 'for the period'); { 'dueDate': $text(dueDate), 'period': $p, 'periodStart': $before($p, ' to '), 'periodEnd': $after($p, ' to ') } )])",
      "exceptions": {
        "needs_auth": {
          "matches": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
        }
      }
    }
  ]
}
