{
  "name": "@djgrant/hmrc/vat-submitted-returns",
  "url": "https://www.tax.service.gov.uk/vat-through-software/vat-returns/submitted",
  "params": {
    "limit": {
      "type": "integer",
      "default": 10
    }
  },
  "returns": {
    "type": "array",
    "items": {
      "period": "string",
      "year": {
        "type": "string",
        "nullable": true
      },
      "periodKey": {
        "type": "string",
        "nullable": true
      },
      "url": {
        "type": "string",
        "nullable": true
      },
      "detail": {
        "$lens": "@djgrant/hmrc/vat-return",
        "params": {
          "year": "year",
          "periodKey": "periodKey"
        }
      }
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "item": "a[href*='/vat-returns/submitted/']",
      "fields": {
        "period": {
          "selector": ":self"
        },
        "url": {
          "selector": ":self",
          "attr": "href"
        }
      },
      "post": "($append([], $map($, function($r){( $parts := $type($r.url) = 'string' ? $split($r.url, '/') : []; $y := $parts[-2]; $k := $parts[-1]; $ok := $type($y) = 'string' and $y != '' and $type($k) = 'string' and $k != ''; { 'period': $strip($r.period, 'View return for the period'), 'year': $ok ? $y : null, 'periodKey': $ok ? $k : null, 'url': $text($r.url), 'detail': $ok ? {} : null } )})[[0..$limit - 1]]))",
      "exceptions": {
        "needs_auth": {
          "matches": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
        }
      }
    }
  ]
}
