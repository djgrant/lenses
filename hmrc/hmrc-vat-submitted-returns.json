{
  "name": "@notation/hmrc/vat-submitted-returns",
  "url": "https://www.tax.service.gov.uk/vat-through-software/vat-returns/submitted",
  "params": {
    "limit": {
      "type": "integer",
      "default": 10
    }
  },
  "returns": {
    "type": "array",
    "items": {
      "period": "string",
      "year": {
        "type": "string",
        "nullable": true
      },
      "periodKey": {
        "type": "string",
        "nullable": true
      },
      "url": {
        "type": "string",
        "nullable": true
      },
      "detail": {
        "$lens": "@notation/hmrc/vat-return",
        "params": {
          "year": "year",
          "periodKey": "periodKey"
        }
      }
    }
  },
  "outcomes": {
    "needs_auth": {
      "hint": "HMRC session expired or not signed in. Open https://www.tax.service.gov.uk/business-account in the browser, sign in, then retry."
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "item": "#content .govuk-tabs__panel ul.govuk-list--bullet > li > a",
      "fields": {
        "period": {
          "selector": ":self"
        },
        "url": {
          "selector": ":self",
          "attr": "href"
        }
      },
      "post": "([$.( $parts := $type(url) = 'string' ? $split(url, '/') : []; $y := $parts[-2]; $k := $parts[-1]; $ok := $type($y) = 'string' and $y != '' and $type($k) = 'string' and $k != ''; { 'period': $strip(period, 'View return for the period'), 'year': $ok ? $y : null, 'periodKey': $ok ? $k : null, 'url': $text(url), 'detail': $ok ? {} : null } )][[0..$limit - 1]])",
      "detect": {
        "needs_auth": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
      }
    }
  ]
}
