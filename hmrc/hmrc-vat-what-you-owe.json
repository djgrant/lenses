{
  "name": "@djgrant/hmrc/vat-what-you-owe",
  "url": "https://www.tax.service.gov.uk/vat-through-software/what-you-owe",
  "returns": {
    "type": "object",
    "fields": {
      "owesAnything": "boolean",
      "summary": "string",
      "totalOwed": {
        "type": "number",
        "nullable": true
      }
    }
  },
  "effects": {
    "reads": [
      "tax.service.gov.uk"
    ],
    "writes": [],
    "idempotent": true
  },
  "resolve": [
    {
      "kind": "dom",
      "fields": {
        "noPayments": {
          "selector": "#no-payments-subheading"
        },
        "totalText": {
          "selector": "#content .govuk-table__cell--numeric"
        }
      },
      "post": "($owes := $not($has(noPayments)); { 'owesAnything': $owes, 'summary': $owes ? 'You have payments due.' : $text(noPayments), 'totalOwed': $owes ? $money(totalText) : 0 })",
      "exceptions": {
        "needs_auth": {
          "matches": "$contains(url, '/sign-in-to-hmrc-online-services/') or $contains(title, 'Sign in to HMRC')"
        }
      }
    }
  ]
}
