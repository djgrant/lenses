{
  "name": "@djgrant/freeagent/cancel-invoice",
  "description": "Cancels an existing FreeAgent invoice by ID and returns FreeAgent's resulting invoice status as confirmation.",
  "url": "https://{account}.freeagent.com/invoices/{invoice_id}",
  "params": {
    "invoice_id": "integer"
  },
  "returns": {
    "type": "object",
    "fields": {
      "cancelled": "boolean",
      "invoice_id": "integer",
      "reference": "string",
      "status": "string",
      "confirmation": "string"
    }
  },
  "outcomes": {
    "needs_auth": {
      "hint": "Sign in to your FreeAgent account, then retry."
    },
    "rejected": {
      "hint": "FreeAgent rejected the cancellation. Check that the invoice exists and can be cancelled."
    }
  },
  "effects": {
    "reads": [
      "FreeAgent invoice page and cancellation result"
    ],
    "writes": [
      "FreeAgent account (marks the selected invoice as Cancelled)"
    ],
    "idempotent": false,
    "cache": 0
  },
  "resolve": [
    {
      "kind": "http",
      "credentials": true,
      "sources": {
        "csrf": {
          "request": "GET https://{account}.freeagent.com/invoices/{invoice_id}",
          "items": "$match($, /name=\"csrf-token\" content=\"([^\"]+)\"/).groups[0]"
        },
        "cancelled_invoice": {
          "request": "PUT https://{account}.freeagent.com/v2/invoices/{invoice_id}/transitions/mark_as_cancelled",
          "credentials": "same-origin-page",
          "headers": {
            "X-CSRF-Token": "$csrf",
            "X-Requested-With": "'XMLHttpRequest'",
            "Accept": "'application/json'"
          }
        }
      },
      "detect": {
        "needs_auth": "$contains($csrf.url, '/login') or $contains($cancelled_invoice.url, '/login') or $csrf.status = 401 or $cancelled_invoice.status = 401",
        "rejected": "$cancelled_invoice.status >= 400"
      },
      "map": "{ 'cancelled': $cancelled_invoice.invoice.status = 'Cancelled', 'invoice_id': $invoice_id, 'reference': $cancelled_invoice.invoice.reference, 'status': $cancelled_invoice.invoice.status, 'confirmation': 'Invoice ' & $cancelled_invoice.invoice.reference & ' cancelled' }"
    }
  ]
}
