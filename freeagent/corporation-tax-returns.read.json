{
  "name": "@djgrant/freeagent/corporation-tax-returns",
  "description": "Reads FreeAgent Corporation Tax returns and balances.",
  "url": "https://{account}.freeagent.com/tax/corporation_tax_returns",
  "returns": {
    "type": "object",
    "fields": {
      "returns": {
        "type": "array",
        "items": {
          "period": "string",
          "accounting_year": {"type": "string", "nullable": true},
          "dated_on": "string",
          "description": "string",
          "payment_due": "string",
          "liability": {"type": "number", "nullable": true},
          "payment": {"type": "number", "nullable": true},
          "balance_owed": "number",
          "url": "string"
        }
      }
    }
  },
  "outcomes": {"needs_auth": {"hint": "Sign in to your FreeAgent account, then retry."}},
  "detect": {"needs_auth": "$contains(url, '/login') or $contains(title, 'Log in')"},
  "helpers": {"money": "function($s) { ($v := $type($s) = 'string' ? $trim($s) : ''; $v = '' ? null : ($neg := $contains($v, '-'); $n := $number($replace($replace($replace($v, /-/, ''), /£/, ''), /,/, '')); $neg ? -$n : $n)) }"},
  "effects": {"reads": ["FreeAgent account Corporation Tax returns"], "writes": [], "idempotent": true, "cache": 0},
  "resolve": [
    {
      "kind": "dom",
      "item": "table.Table tbody tr:has(a[href*='/tax/corporation_tax_returns/'])",
      "fields": {
        "dated_on": {"selector": "td:has(+ td a[href*='/tax/corporation_tax_returns/'])"},
        "description": {"selector": "a[href*='/tax/corporation_tax_returns/']"},
        "href": {"selector": "a[href*='/tax/corporation_tax_returns/']", "attr": "href"},
        "payment_due": {"selector": "td:has(> a[href*='/tax/corporation_tax_returns/']) + td"},
        "liability": {"selector": "td.num.liability"},
        "payment": {"selector": "td.num.payment"},
        "balance_owed": {"selector": "td.num:not(.liability):not(.payment)"}
      },
      "post": "{'returns': [$[$type(href) = 'string'].{'period': $match(href, /corporation_tax_returns\\/([^/?]+)/).groups[0], 'accounting_year': $type(description) = 'string' ? $match(description, /[0-9]{4}\\/[0-9]{2}/)[0].match : null, 'dated_on': dated_on, 'description': description, 'payment_due': payment_due, 'liability': $money(liability), 'payment': $money(payment), 'balance_owed': $money(balance_owed), 'url': href}]}"
    }
  ]
}
